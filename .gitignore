# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
vivabox-coming-soon/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
vivabox-coming-soon/.next/

# production
/build

# misc
.DS_Store
*.pem

# raw/unprocessed media masters (not shipped)
/assets-raw

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# experience images cached from the Google Sheet at build time (see scripts/cache-experience-images.mjs)
/public/images/experiences/*
!/public/images/experiences/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# Google Sheets OAuth credentials/tokens (see scripts/sheet-sync)
/scripts/sheet-sync/.credentials/

# Supabase CLI local state
/supabase/.temp/
