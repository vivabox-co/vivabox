# Supabase — service role, jamais exposé au navigateur
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — emails transaccionales
RESEND_API_KEY=

# Panel interno de pedidos (Basic Auth)
ORDERS_ADMIN_USER=
ORDERS_ADMIN_PASSWORD=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# Wompi — pasarela de pago (docs/09_checkout.md, docs/05_technical.md)
# Claves de prueba (pub_test_/prv_test_) o producción (pub_prod_/prv_prod_)
# desde el Dashboard Wompi > Configuración > Secretos de integración técnica.
# La clave pública es la única expuesta al navegador (NEXT_PUBLIC_).
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
