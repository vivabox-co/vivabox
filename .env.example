# Supabase — service role, jamais exposé au navigateur
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — emails transaccionales
RESEND_API_KEY=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# Wompi — pasarela de pago (docs/09_checkout.md, docs/05_technical.md)
# Claves de prueba (pub_test_/prv_test_) o producción (pub_prod_/prv_prod_)
# desde el Dashboard Wompi > Configuración > Secretos de integración técnica.
# La clave pública es la única expuesta al navegador (NEXT_PUBLIC_).
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Emails al comprador (services/buyerEmail.ts) — se envían desde el subdominio
# verificado en Resend (el dominio raíz no lo está). Opcional: valor por defecto
# "Vivabox <notificaciones@notify.vivabox.com.co>".
BUYER_EMAIL_FROM=

# Secreto compartido con vivabox-operativo para /api/internal/buyer-email
# (pago Bre-B confirmado, caja enviada). Mismo valor en los dos proyectos;
# generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=
